# Required. Use your own Feishu/Lark Base app token and table id.
FEISHU_BASE_TOKEN=replace_with_your_base_token
FEISHU_TABLE_ID=replace_with_your_table_id

# Required for Gemini video analysis.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional. Set these only when the executables are not available in PATH.
LARK_CLI=
MEOWLOAD_BIN=

